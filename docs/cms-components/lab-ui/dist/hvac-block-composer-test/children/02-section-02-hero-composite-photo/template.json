  "children": [],
  "head": "",
  "html": "<section class=\"composition-section composition-section--hero-composite-photo\" data-composition-block=\"hero.composite-photo\">\n<!-- lab-ui block · hero.composite-photo\n     Vertical-landing hero · left text + right composite photo with\n     overlay person-cards + dark stat chip.\n     Photo slot accepts ${SECTION_02_HERO_COMPOSITE_PHOTO_PHOTO_URL@IMAGE} (URL param) so each vertical brings\n     its own imagery (lorem-cyan, lorem-green, etc.). Default fallback is\n     a neutral striped media placeholder.\n     Light theme.\n-->\n<section class=\"herop\" data-block=\"hero.composite-photo\">\n  <div class=\"container herop-grid\">\n    <div class=\"herop-content\">\n      <div class=\"herop-eyebrow\">\n        <span>${SECTION_02_HERO_COMPOSITE_PHOTO_EYEBROW_ROOT@LOCALIZED_STRING_SS}</span>\n        <span class=\"crumb-sep\">/</span>\n        <span class=\"crumb-cur\">${SECTION_02_HERO_COMPOSITE_PHOTO_EYEBROW_LEAF@LOCALIZED_STRING_SS}</span>\n      </div>\n      <h1 class=\"herop-title\">\n        ${SECTION_02_HERO_COMPOSITE_PHOTO_TITLE_LINE_1@LOCALIZED_STRING_SS}<br/>\n        for <span class=\"accent\">${SECTION_02_HERO_COMPOSITE_PHOTO_TITLE_ACCENT@LOCALIZED_STRING_SS}</span><br/>\n        ${SECTION_02_HERO_COMPOSITE_PHOTO_TITLE_LINE_2@LOCALIZED_STRING_SS}\n      </h1>\n      <div class=\"herop-leads\">\n        <p>${SECTION_02_HERO_COMPOSITE_PHOTO_LEAD_1@LOCALIZED_STRING_SS}</p>\n        <p>${SECTION_02_HERO_COMPOSITE_PHOTO_LEAD_2@LOCALIZED_STRING_SS}</p>\n      </div>\n      <div class=\"herop-cta\">\n        <a class=\"btn btn-primary btn-primary-ring\" href=\"${SECTION_02_HERO_COMPOSITE_PHOTO_CTA_PRIMARY_HREF@STRING}\">\n          <svg class=\"btn-star\" width=\"16\" height=\"16\" viewBox=\"0 0 21 21\" fill=\"currentColor\" aria-hidden=\"true\">\n            <path d=\"M10.5 0L13.4698 7.53015L21 10.5L13.4698 13.4698L10.5 21L7.53015 13.4698L0 10.5L7.53015 7.53015L10.5 0Z\"/>\n          </svg>\n          ${SECTION_02_HERO_COMPOSITE_PHOTO_CTA_PRIMARY_LABEL@LOCALIZED_STRING_SS}\n        </a>\n        <a class=\"btn btn-secondary btn-secondary-filled\" href=\"${SECTION_02_HERO_COMPOSITE_PHOTO_CTA_SECONDARY_HREF@STRING}\">\n          <svg class=\"btn-star\" width=\"16\" height=\"16\" viewBox=\"0 0 21 21\" fill=\"currentColor\" aria-hidden=\"true\">\n            <path d=\"M10.5 0L13.4698 7.53015L21 10.5L13.4698 13.4698L10.5 21L7.53015 13.4698L0 10.5L7.53015 7.53015L10.5 0Z\"/>\n          </svg>\n          ${SECTION_02_HERO_COMPOSITE_PHOTO_CTA_SECONDARY_LABEL@LOCALIZED_STRING_SS}\n        </a>\n      </div>\n    </div>\n\n    <div class=\"herop-art\" aria-hidden=\"true\">\n      <div class=\"herop-photo\" data-photo-slot>\n        <!-- Photo. Replace with <img src=\"${SECTION_02_HERO_COMPOSITE_PHOTO_PHOTO_URL@IMAGE}\" alt=\"\"> or\n             keep this placeholder for the default fallback. -->\n        <div class=\"herop-photo-placeholder\">\n          <span>${SECTION_02_HERO_COMPOSITE_PHOTO_PLACEHOLDER_SIZE@LOCALIZED_STRING_SS}</span>\n          <span>${SECTION_02_HERO_COMPOSITE_PHOTO_PLACEHOLDER_LABEL@LOCALIZED_STRING_SS}</span>\n        </div>\n      </div>\n\n      <!-- Overlay: dark stat chip -->\n      <div class=\"herop-chip\" data-overlay=\"chip\">\n        <span class=\"herop-chip-num\">${SECTION_02_HERO_COMPOSITE_PHOTO_CHIP_STAT_VALUE@LOCALIZED_STRING_SS}</span>\n        <span class=\"herop-chip-label\">${SECTION_02_HERO_COMPOSITE_PHOTO_CHIP_STAT_LABEL@LOCALIZED_STRING_SS}</span>\n      </div>\n\n      <!-- Overlay: 2 person cards -->\n      <div class=\"herop-person herop-person--1\" data-overlay=\"person-1\">\n        <div class=\"herop-person-avatar\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 40 40\" fill=\"none\"><circle cx=\"20\" cy=\"20\" r=\"20\" fill=\"#6BC0F9\"/><circle cx=\"20\" cy=\"16\" r=\"6\" fill=\"#FFFFFF\"/><path d=\"M8 34 a12 12 0 0 1 24 0\" fill=\"#FFFFFF\"/></svg>\n        </div>\n        <div>\n          <p class=\"herop-person-name\">${SECTION_02_HERO_COMPOSITE_PHOTO_PERSON_1_NAME@LOCALIZED_STRING_SS}</p>\n          <p class=\"herop-person-role\">${SECTION_02_HERO_COMPOSITE_PHOTO_PERSON_1_ROLE@LOCALIZED_STRING_SS}</p>\n        </div>\n      </div>\n\n      <div class=\"herop-person herop-person--2\" data-overlay=\"person-2\">\n        <div class=\"herop-person-avatar\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 40 40\" fill=\"none\"><circle cx=\"20\" cy=\"20\" r=\"20\" fill=\"#FFA72C\"/><circle cx=\"20\" cy=\"16\" r=\"6\" fill=\"#FFFFFF\"/><path d=\"M8 34 a12 12 0 0 1 24 0\" fill=\"#FFFFFF\"/></svg>\n        </div>\n        <div>\n          <p class=\"herop-person-name\">${SECTION_02_HERO_COMPOSITE_PHOTO_PERSON_2_NAME@LOCALIZED_STRING_SS}</p>\n          <p class=\"herop-person-role\">${SECTION_02_HERO_COMPOSITE_PHOTO_PERSON_2_ROLE@LOCALIZED_STRING_SS}</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n</section>",
