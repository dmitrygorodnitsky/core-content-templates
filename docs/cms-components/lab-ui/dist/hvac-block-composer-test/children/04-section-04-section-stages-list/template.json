  "html": "<section class=\"composition-section composition-section--section-stages-list\" data-composition-block=\"section.stages-list\">\n<div class=\"stage-wrap\">\n<!-- lab-ui block · section.stages-list\n     Vertical growth ladder: 4 stages (01–04). Each stage has a side rail\n     with stage eyebrow + big number + 4-tick scale that fills as stages\n     progress (lv1 → lv4 cyan glow), and a main area with title + users\n     pill + lead + capability chips. Light theme. Designer kit StagesList.\n-->\n<div class=\"stages-list\" data-block=\"section.stages-list\">\n  <article class=\"stage stage--lv1\" data-stage=\"01\">\n    <div class=\"stage-side\">\n      <span class=\"stage-eyebrow\">${SECTION_04_SECTION_STAGES_LIST_STAGE_LABEL@LOCALIZED_STRING_SS}</span>\n      <span class=\"stage-num\">${SECTION_04_SECTION_STAGES_LIST_STAGE_1_NUM@LOCALIZED_STRING_SS}</span>\n      <div class=\"stage-scale\" aria-hidden=\"true\">\n        <span class=\"stage-tick is-on\"></span>\n        <span class=\"stage-tick\"></span>\n        <span class=\"stage-tick\"></span>\n        <span class=\"stage-tick\"></span>\n      </div>\n    </div>\n    <div class=\"stage-main\">\n      <div class=\"stage-title-row\">\n        <h3 class=\"stage-title\">${SECTION_04_SECTION_STAGES_LIST_STAGE_1_TITLE@LOCALIZED_STRING_SS}</h3>\n        <span class=\"stage-users\">${SECTION_04_SECTION_STAGES_LIST_STAGE_1_USERS@LOCALIZED_STRING_SS}</span>\n      </div>\n      <p class=\"stage-lead\">${SECTION_04_SECTION_STAGES_LIST_STAGE_1_LEAD@LOCALIZED_STRING_SS}</p>\n      <div class=\"stage-caps\">\n        <span class=\"stage-chip\"><span>${SECTION_04_SECTION_STAGES_LIST_STAGE_1_CHIP_1@LOCALIZED_STRING_SS}</span></span>\n        <span class=\"stage-chip\"><span>${SECTION_04_SECTION_STAGES_LIST_STAGE_1_CHIP_2@LOCALIZED_STRING_SS}</span></span>\n        <span class=\"stage-chip\"><span>${SECTION_04_SECTION_STAGES_LIST_STAGE_1_CHIP_3@LOCALIZED_STRING_SS}</span></span>\n        <span class=\"stage-chip\"><span>${SECTION_04_SECTION_STAGES_LIST_STAGE_1_CHIP_4@LOCALIZED_STRING_SS}</span></span>\n        <span class=\"stage-chip\"><span>${SECTION_04_SECTION_STAGES_LIST_STAGE_1_CHIP_5@LOCALIZED_STRING_SS}</span></span>\n      </div>\n    </div>\n  </article>\n\n  <article class=\"stage stage--lv2\" data-stage=\"02\">\n    <div class=\"stage-side\">\n      <span class=\"stage-eyebrow\">${SECTION_04_SECTION_STAGES_LIST_STAGE_LABEL@LOCALIZED_STRING_SS}</span>\n      <span class=\"stage-num\">${SECTION_04_SECTION_STAGES_LIST_STAGE_2_NUM@LOCALIZED_STRING_SS}</span>\n      <div class=\"stage-scale\" aria-hidden=\"true\">\n        <span class=\"stage-tick is-on\"></span>\n        <span class=\"stage-tick is-on\"></span>\n        <span class=\"stage-tick\"></span>\n        <span class=\"stage-tick\"></span>\n      </div>\n    </div>\n    <div class=\"stage-main\">\n      <div class=\"stage-title-row\">\n        <h3 class=\"stage-title\">${SECTION_04_SECTION_STAGES_LIST_STAGE_2_TITLE@LOCALIZED_STRING_SS}</h3>\n        <span class=\"stage-users\">${SECTION_04_SECTION_STAGES_LIST_STAGE_2_USERS@LOCALIZED_STRING_SS}</span>\n      </div>\n      <p class=\"stage-lead\">${SECTION_04_SECTION_STAGES_LIST_STAGE_2_LEAD@LOCALIZED_STRING_SS}</p>\n      <div class=\"stage-caps\">\n        <span class=\"stage-chip\"><span class=\"stage-chip-plus\">+</span><span>${SECTION_04_SECTION_STAGES_LIST_STAGE_2_CHIP_1@LOCALIZED_STRING_SS}</span></span>\n        <span class=\"stage-chip\"><span class=\"stage-chip-plus\">+</span><span>${SECTION_04_SECTION_STAGES_LIST_STAGE_2_CHIP_2@LOCALIZED_STRING_SS}</span></span>\n        <span class=\"stage-chip\"><span class=\"stage-chip-plus\">+</span><span>${SECTION_04_SECTION_STAGES_LIST_STAGE_2_CHIP_3@LOCALIZED_STRING_SS}</span></span>\n        <span class=\"stage-chip\"><span class=\"stage-chip-plus\">+</span><span>${SECTION_04_SECTION_STAGES_LIST_STAGE_2_CHIP_4@LOCALIZED_STRING_SS}</span></span>\n      </div>\n    </div>\n  </article>\n\n  <article class=\"stage stage--lv3\" data-stage=\"03\">\n    <div class=\"stage-side\">\n      <span class=\"stage-eyebrow\">${SECTION_04_SECTION_STAGES_LIST_STAGE_LABEL@LOCALIZED_STRING_SS}</span>\n      <span class=\"stage-num\">${SECTION_04_SECTION_STAGES_LIST_STAGE_3_NUM@LOCALIZED_STRING_SS}</span>\n      <div class=\"stage-scale\" aria-hidden=\"true\">\n        <span class=\"stage-tick is-on\"></span>\n        <span class=\"stage-tick is-on\"></span>\n        <span class=\"stage-tick is-on\"></span>\n        <span class=\"stage-tick\"></span>\n      </div>\n    </div>\n    <div class=\"stage-main\">\n      <div class=\"stage-title-row\">\n        <h3 class=\"stage-title\">${SECTION_04_SECTION_STAGES_LIST_STAGE_3_TITLE@LOCALIZED_STRING_SS}</h3>\n        <span class=\"stage-users\">${SECTION_04_SECTION_STAGES_LIST_STAGE_3_USERS@LOCALIZED_STRING_SS}</span>\n      </div>\n      <p class=\"stage-lead\">${SECTION_04_SECTION_STAGES_LIST_STAGE_3_LEAD@LOCALIZED_STRING_SS}</p>\n      <div class=\"stage-caps\">\n        <span class=\"stage-chip\"><span class=\"stage-chip-plus\">+</span><span>${SECTION_04_SECTION_STAGES_LIST_STAGE_3_CHIP_1@LOCALIZED_STRING_SS}</span></span>\n        <span class=\"stage-chip\"><span class=\"stage-chip-plus\">+</span><span>${SECTION_04_SECTION_STAGES_LIST_STAGE_3_CHIP_2@LOCALIZED_STRING_SS}</span></span>\n        <span class=\"stage-chip\"><span class=\"stage-chip-plus\">+</span><span>${SECTION_04_SECTION_STAGES_LIST_STAGE_3_CHIP_3@LOCALIZED_STRING_SS}</span></span>\n        <span class=\"stage-chip\"><span class=\"stage-chip-plus\">+</span><span>${SECTION_04_SECTION_STAGES_LIST_STAGE_3_CHIP_4@LOCALIZED_STRING_SS}</span></span>\n      </div>\n    </div>\n  </article>\n\n  <article class=\"stage stage--lv4\" data-stage=\"04\">\n    <div class=\"stage-side\">\n      <span class=\"stage-eyebrow\">${SECTION_04_SECTION_STAGES_LIST_STAGE_LABEL@LOCALIZED_STRING_SS}</span>\n      <span class=\"stage-num\">${SECTION_04_SECTION_STAGES_LIST_STAGE_4_NUM@LOCALIZED_STRING_SS}</spa