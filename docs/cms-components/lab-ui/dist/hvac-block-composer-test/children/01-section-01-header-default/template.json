  "html": "<div class=\"header-host\">\n<!-- lab-ui block · header.default\n     Canonical header for any landing page.\n     Brand + multi-level nav + locale + ring CTA + burger.\n     Each nav item declares its kind via data-kind:\n       link     · plain anchor                                        (Pricing, Customers, ...)\n       dropdown · single-column panel of links                         (Resources)\n       mega     · multi-column panel with section headings + links     (Platform, Industries)\n     One renderer / one CSS file handles all three.\n     Light theme.\n     Composes: cta.btn-primary-ring + language.locale-dropdown.\n     Optional breadcrumb chip is owned here so header + breadcrumb stay\n     a single source of truth.\n-->\n<header class=\"header header--default\" role=\"banner\" data-block=\"header.default\">\n  <div class=\"container\">\n    <div class=\"header-inner\">\n\n      <a class=\"header-logo\" href=\"${SECTION_01_HEADER_DEFAULT_BRAND_HREF@STRING}\" aria-label=\"${SECTION_01_HEADER_DEFAULT_BRAND_NAME@LOCALIZED_STRING_SS}\">\n        <svg viewBox=\"0 0 21 21\" width=\"22\" height=\"22\" fill=\"currentColor\" aria-hidden=\"true\">\n          <path d=\"M10.5 0L13.4698 7.53015L21 10.5L13.4698 13.4698L10.5 21L7.53015 13.4698L0 10.5L7.53015 7.53015L10.5 0Z\"/>\n        </svg>\n        <span class=\"header-logo-text\">${SECTION_01_HEADER_DEFAULT_BRAND_NAME@LOCALIZED_STRING_SS}</span>\n      </a>\n\n      <nav class=\"header-nav\" aria-label=\"Primary\" data-nav>\n        <!--\n          Each <li> declares its kind. CMS generator emits the right\n          inner markup based on the kind. Unfilled slots auto-hide.\n\n          item kinds:\n            link      · single <a class=\"nav-link\">\n            dropdown  · trigger + <ul class=\"nav-panel nav-panel--list\">\n            mega      · trigger + <div class=\"nav-panel nav-panel--mega\"> with <section> columns\n        -->\n\n        <!-- 1 · MEGA — Platform -->\n        <div class=\"nav-item\" data-kind=\"mega\" data-nav-item>\n          <button class=\"nav-link nav-trigger\" type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">\n            ${SECTION_01_HEADER_DEFAULT_ITEM_1_LABEL@LOCALIZED_STRING_SS}\n            <svg class=\"nav-chev\" width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M1 1l4 4 4-4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n            </svg>\n          </button>\n          <div class=\"nav-panel nav-panel--mega\" role=\"menu\">\n            <section class=\"nav-mega-col\">\n              <h4 class=\"nav-mega-title\">${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_1_TITLE@LOCALIZED_STRING_SS}</h4>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_1_LINK_1_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_1_LINK_1_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_1_LINK_2_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_1_LINK_2_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_1_LINK_3_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_1_LINK_3_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_1_LINK_4_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_1_LINK_4_LABEL@LOCALIZED_STRING_SS}</a>\n            </section>\n            <section class=\"nav-mega-col\">\n              <h4 class=\"nav-mega-title\">${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_2_TITLE@LOCALIZED_STRING_SS}</h4>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_2_LINK_1_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_2_LINK_1_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_2_LINK_2_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_2_LINK_2_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_2_LINK_3_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_2_LINK_3_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_2_LINK_4_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_1_COL_2_LINK_4_LABEL@LOCALIZED_STRING_SS}</a>\n            </section>\n          </div>\n        </div>\n\n        <!-- 2 · MEGA — Industries -->\n        <div class=\"nav-item\" data-kind=\"mega\" data-nav-item>\n          <button class=\"nav-link nav-trigger\" type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">\n            ${SECTION_01_HEADER_DEFAULT_ITEM_2_LABEL@LOCALIZED_STRING_SS}\n            <svg class=\"nav-chev\" width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M1 1l4 4 4-4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n            </svg>\n          </button>\n          <div class=\"nav-panel nav-panel--mega\" role=\"menu\">\n            <section class=\"nav-mega-col\">\n              <h4 class=\"nav-mega-title\">${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_1_TITLE@LOCALIZED_STRING_SS}</h4>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_1_LINK_1_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_1_LINK_1_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_1_LINK_2_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_1_LINK_2_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_1_LINK_3_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_1_LINK_3_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_1_LINK_4_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_1_LINK_4_LABEL@LOCALIZED_STRING_SS}</a>\n            </section>\n            <section class=\"nav-mega-col\">\n              <h4 class=\"nav-mega-title\">${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_2_TITLE@LOCALIZED_STRING_SS}</h4>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_2_LINK_1_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_2_LINK_1_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_2_LINK_2_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_2_LINK_2_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_2_LINK_3_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_2_LINK_3_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_2_LINK_4_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_2_COL_2_LINK_4_LABEL@LOCALIZED_STRING_SS}</a>\n            </section>\n          </div>\n        </div>\n\n        <!-- 3 · LINK — How It Works -->\n        <div class=\"nav-item\" data-kind=\"link\" data-nav-item>\n          <a class=\"nav-link\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_3_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_3_LABEL@LOCALIZED_STRING_SS}</a>\n        </div>\n\n        <!-- 4 · LINK — Partners -->\n        <div class=\"nav-item\" data-kind=\"link\" data-nav-item>\n          <a class=\"nav-link\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_4_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_4_LABEL@LOCALIZED_STRING_SS}</a>\n        </div>\n\n        <!-- 5 · DROPDOWN — Resources -->\n        <div class=\"nav-item\" data-kind=\"dropdown\" data-nav-item>\n          <button class=\"nav-link nav-trigger\" type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">\n            ${SECTION_01_HEADER_DEFAULT_ITEM_5_LABEL@LOCALIZED_STRING_SS}\n            <svg class=\"nav-chev\" width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M1 1l4 4 4-4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n            </svg>\n          </button>\n          <ul class=\"nav-panel nav-panel--list\" role=\"menu\">\n            <li><a class=\"nav-list-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_5_LINK_1_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_5_LINK_1_LABEL@LOCALIZED_STRING_SS}</a></li>\n            <li><a class=\"nav-list-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_5_LINK_2_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_5_LINK_2_LABEL@LOCALIZED_STRING_SS}</a></li>\n            <li><a class=\"nav-list-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_5_LINK_3_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_5_LINK_3_LABEL@LOCALIZED_STRING_SS}</a></li>\n            <li><a class=\"nav-list-link\" role=\"menuitem\" href=\"${SECTION_01_HEADER_DEFAULT_ITEM_5_LINK_4_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_ITEM_5_LINK_4_LABEL@LOCALIZED_STRING_SS}</a></li>\n          </ul>\n        </div>\n\n      </nav>\n\n      <div class=\"header-actions\">\n        <!-- Slot: locale (block: language.locale-dropdown) -->\n        <div class=\"locale-selector\" data-block=\"language.locale-dropdown\">\n          <button class=\"locale-trigger\" aria-haspopup=\"listbox\" aria-expanded=\"false\">\n            <div class=\"locale-trigger-left\">\n              <svg class=\"locale-chevron\" width=\"13\" height=\"8\" viewBox=\"0 0 13 8\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M0.672729 0.73999L6.17273 5.73999L11.6727 0.73999\" stroke=\"currentColor\" stroke-width=\"2\"/>\n              </svg>\n              <span class=\"locale-trigger-label\">${SECTION_01_HEADER_DEFAULT_LOCALE_LABEL@LOCALIZED_STRING_SS}</span>\n            </div>\n          </button>\n          <div class=\"locale-dropdown\" role=\"listbox\" aria-label=\"Select language\">\n            <ul class=\"locale-list\"></ul>\n          </div>\n        </div>\n\n        <!-- Slot: primary CTA (block: cta.btn-primary-ring) -->\n        <a class=\"btn btn-primary btn-primary-ring header-cta\" href=\"${SECTION_01_HEADER_DEFAULT_CTA_HREF@STRING}\">\n          <svg class=\"btn-star\" width=\"16\" height=\"16\" viewBox=\"0 0 21 21\" fill=\"currentColor\" aria-hidden=\"true\">\n            <path d=\"M10.5 0L13.4698 7.53015L21 10.5L13.4698 13.4698L10.5 21L7.53015 13.4698L0 10.5L7.53015 7.53015L10.5 0Z\"/>\n          </svg>\n          ${SECTION_01_HEADER_DEFAULT_CTA_LABEL@LOCALIZED_STRING_SS}\n        </a>\n\n        <button class=\"burger\" aria-label=\"Open menu\" aria-expanded=\"false\">\n          <span></span><span></span><span></span>\n        </button>\n      </div>\n\n    </div>\n  </div>\n</header>\n\n<div class=\"bc-chip\" data-block=\"header.default-breadcrumb\" role=\"navigation\" aria-label=\"Breadcrumb\">\n  <a class=\"bc-link bc-root\" href=\"${SECTION_01_HEADER_DEFAULT_BREADCRUMB_ROOT_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_BREADCRUMB_ROOT_LABEL@LOCALIZED_STRING_SS}</a>\n  <span class=\"bc-sep\" data-sep-for=\"mid_1\" aria-hidden=\"true\">&gt;</span>\n  <a class=\"bc-link\" data-mid=\"1\" href=\"${SECTION_01_HEADER_DEFAULT_BREADCRUMB_MID_1_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_BREADCRUMB_MID_1_LABEL@LOCALIZED_STRING_SS}</a>\n  <span class=\"bc-sep\" data-sep-for=\"mid_2\" aria-hidden=\"true\">&gt;</span>\n  <a class=\"bc-link\" data-mid=\"2\" href=\"${SECTION_01_HEADER_DEFAULT_BREADCRUMB_MID_2_HREF@STRING}\">${SECTION_01_HEADER_DEFAULT_BREADCRUMB_MID_2_LABEL@LOCALIZED_STRING_SS}</a>\n  <span class=\"bc-sep\" data-sep-for=\"current\" aria-hidden=\"true\">&gt;</span>\n  <span class=\"bc-current\" aria-current=\"page\">${SECTION_01_HEADER_DEFAULT_BREADCRUMB_CURRENT_LABEL@LOCALIZED_STRING_SS}</span>\n</div>\n\n</div>",
