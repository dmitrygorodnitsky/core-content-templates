  "html": "<section class=\"composition-section composition-section--mobile-4-card-glyph\" data-composition-block=\"mobile.4-card-glyph\">\n<!-- lab-ui block · mobile.4-card-glyph\n     Mobile-experience section · H2 + 3 ledes + 4 cards.\n     Each card: SVG glyph + title + 2 body paragraphs. Light theme.\n-->\n<section class=\"mob4\" data-block=\"mobile.4-card-glyph\">\n  <div class=\"container\">\n    <header class=\"mob4-top\">\n      <p class=\"eyebrow\">${SECTION_05_MOBILE_4_CARD_GLYPH_EYEBROW@LOCALIZED_STRING_SS}</p>\n      <h2 class=\"mob4-title\">${SECTION_05_MOBILE_4_CARD_GLYPH_TITLE@LOCALIZED_STRING_SS}</h2>\n      <div class=\"mob4-lede\">\n        <p>${SECTION_05_MOBILE_4_CARD_GLYPH_LEDE_1@LOCALIZED_STRING_SS}</p>\n        <p>${SECTION_05_MOBILE_4_CARD_GLYPH_LEDE_2@LOCALIZED_STRING_SS}</p>\n        <p>${SECTION_05_MOBILE_4_CARD_GLYPH_LEDE_3@LOCALIZED_STRING_SS}</p>\n      </div>\n    </header>\n\n    <div class=\"mob4-grid\">\n      <article class=\"mob4-card\" data-slot=\"01\">\n        <div class=\"mob4-glyph\" aria-hidden=\"true\" data-glyph-slot=\"01\">\n          <svg viewBox=\"0 0 64 64\" fill=\"none\"><rect x=\"14\" y=\"6\" width=\"36\" height=\"52\" rx=\"6\" stroke=\"currentColor\" stroke-width=\"2\"/><line x1=\"22\" y1=\"14\" x2=\"42\" y2=\"14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"22\" y1=\"22\" x2=\"42\" y2=\"22\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"22\" y1=\"30\" x2=\"34\" y2=\"30\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"32\" cy=\"50\" r=\"2.5\" fill=\"currentColor\"/></svg>\n        </div>\n        <h3 class=\"mob4-card-title\">${SECTION_05_MOBILE_4_CARD_GLYPH_CARD_1_TITLE@LOCALIZED_STRING_SS}</h3>\n        <p class=\"mob4-card-p\">${SECTION_05_MOBILE_4_CARD_GLYPH_CARD_1_P1@LOCALIZED_STRING_SS}</p>\n        <p class=\"mob4-card-p\">${SECTION_05_MOBILE_4_CARD_GLYPH_CARD_1_P2@LOCALIZED_STRING_SS}</p>\n      </article>\n      <article class=\"mob4-card\" data-slot=\"02\">\n        <div class=\"mob4-glyph\" aria-hidden=\"true\" data-glyph-slot=\"02\">\n          <svg viewBox=\"0 0 64 64\" fill=\"none\"><circle cx=\"32\" cy=\"32\" r=\"22\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M22 32l8 8 14-16\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </div>\n        <h3 class=\"mob4-card-title\">${SECTION_05_MOBILE_4_CARD_GLYPH_CARD_2_TITLE@LOCALIZED_STRING_SS}</h3>\n        <p class=\"mob4-card-p\">${SECTION_05_MOBILE_4_CARD_GLYPH_CARD_2_P1@LOCALIZED_STRING_SS}</p>\n        <p class=\"mob4-card-p\">${SECTION_05_MOBILE_4_CARD_GLYPH_CARD_2_P2@LOCALIZED_STRING_SS}</p>\n      </article>\n      <article class=\"mob4-card\" data-slot=\"03\">\n        <div class=\"mob4-glyph\" aria-hidden=\"true\" data-glyph-slot=\"03\">\n          <svg viewBox=\"0 0 64 64\" fill=\"none\"><path d=\"M14 36 L26 24 L34 32 L50 16\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M44 16 L50 16 L50 22\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"14\" y1=\"48\" x2=\"50\" y2=\"48\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n        </div>\n        <h3 class=\"mob4-card-title\">${SECTION_05_MOBILE_4_CARD_GLYPH_CARD_3_TITLE@LOCALIZED_STRING_SS}</h3>\n        <p class=\"mob4-card-p\">${SECTION_05_MOBILE_4_CARD_GLYPH_CARD_3_P1@LOCALIZED_STRING_SS}</p>\n        <p class=\"mob4-card-p\">${SECTION_05_MOBILE_4_CARD_GLYPH_CARD_3_P2@LOCALIZED_STRING_SS}</p>\n      </article>\n      <article class=\"mob4-card\" data-slot=\"04\">\n        <div class=\"mob4-glyph\" aria-hidden=\"true\" data-glyph-slot=\"04\">\n          <svg viewBox=\"0 0 64 64\" fill=\"none\"><path d=\"M18 10h22l8 8v36H18V10Z\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/><path d=\"M40 10v9h8\" stroke=\"