  "html": "<!-- lab-ui block · hero.operational-diagram\n     Signature hub hero. Left: eyebrow + H1 + 3 lead paragraphs + CTA pair.\n     Right: neutral screenshot/image placeholder. Replace the placeholder\n     with an actual product image when the CMS/media layer provides one.\n     Theme: light (sw tokens). Adapted from v5 dark variant.\n     Composes: cta.btn-primary-ring + cta.btn-secondary-filled (CTA pair).\n     Param contract: see block.json.\n-->\n<section class=\"hero hero--diagram\" id=\"hero\" data-block=\"hero.operational-diagram\">\n  <div class=\"container hero-grid\">\n\n    <div class=\"hero-content\">\n      <div class=\"hero-eyebrow\">\n        <span>${HERO_EYEBROW_ROOT@LOCALIZED_STRING_SS}</span>\n        <span class=\"crumb-sep\">/</span>\n        <span class=\"crumb-cur\">${HERO_EYEBROW_LEAF@LOCALIZED_STRING_SS}</span>\n      </div>\n      <h1 class=\"hero-title\">\n        ${HERO_TITLE_LINE_1@LOCALIZED_STRING_SS}<br/>\n        for <span class=\"accent\">${HERO_TITLE_ACCENT@LOCALIZED_STRING_SS}</span><br/>\n        ${HERO_TITLE_LINE_2@LOCALIZED_STRING_SS}\n      </h1>\n      <div class=\"hero-leads\">\n        <p>${HERO_LEAD_1@LOCALIZED_STRING_SS}</p>\n        <p>${HERO_LEAD_2@LOCALIZED_STRING_SS}</p>\n        <p>${HERO_LEAD_3@LOCALIZED_STRING_SS}</p>\n      </div>\n      <div class=\"hero-cta\">\n        <a class=\"btn btn-primary btn-primary-ring\" href=\"${HERO_CTA_PRIMARY_HREF@STRING}\">\n          <svg class=\"btn-star\" width=\"16\" height=\"16\" viewBox=\"0 0 21 21\" fill=\"currentColor\" aria-hidden=\"true\">\n            <path d=\"M10.5 0L13.4698 7.53015L21 10.5L13.4698 13.4698L10.5 21L7.53015 13.4698L0 10.5L7.53015 7.53015L10.5 0Z\"/>\n          </svg>\n          ${HERO_CTA_PRIMARY_LABEL@LOCALIZED_STRING_SS}\n        </a>\n        <a class=\"btn btn-secondary btn-secondary-filled\" href=\"${HERO_CTA_SECONDARY_HREF@STRING}\">\n          <svg class=\"btn-star\" width=\"16\" height=\"16\" viewBox=\"0 0 21 21\" fill=\"currentColor\" aria-hidden=\"true\">\n            <path d=\"M10.5 0L13.4698 7.53015L21 10.5L13.4698 13.4698L10.5 21L7.53015 13.4698L0 10.5L7.53015 7.53015L10.5 0Z\"/>\n          </svg>\n          ${HERO_CTA_SECONDARY_LABEL@LOCALIZED_STRING_SS}\n        </a>\n      </div>\n    </div>\n\n    <div class=\"hero-art\" aria-hidden=\"true\">\n      <div class=\"hero-media-placeholder\" data-screenshot-slot>\n        <div class=\"hero-media-surface\">\n          <div class=\"hero-placeholder-copy\">\n            <span>${HERO_PLACEHOLDER_SIZE@LOCALIZED_STRING_SS}</span>\n            <span>${HERO_PLACEHOLDER_LABEL@LOCALIZED_STRING_SS}</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n  </div>\n</section>\n",
