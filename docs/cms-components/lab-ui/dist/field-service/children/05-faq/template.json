    {
      "code": "FAQ_1",
      "nls": {
        "en": {
          "NAME": "Can ServiceWand support multiple service lines?"
        }
      },
      "templateLanguage": "JTE",
      "parent": {
        "code": "FAQ"
      },
      "children": [],
      "head": "",
      "html": "<details class=\"faq-item is-open\" data-faq-slot=\"01\" open>\n  <summary class=\"faq-q\"><span class=\"faq-q-text\">${FAQ_1_QUESTION@LOCALIZED_STRING_SS}</span><span class=\"faq-q-toggle\" aria-hidden=\"true\"><svg width=\"11\" height=\"11\" viewBox=\"0 0 11 11\" fill=\"none\"><path d=\"M5.5 1v9M1 5.5h9\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg></span></summary>\n  <div class=\"faq-a\">${FAQ_1_ANSWER@LOCALIZED_STRING_SS}</div>\n</details>",
      "css": "",
      "javascript": "",
      "parameters": [
        {
          "code": "FAQ_1_QUESTION",
          "type": "LOCALIZED_STRING_SS",
          "nls": {
            "en": {
              "NAME": "QUESTION"
            }
          },
          "value": {
            "en": "Can ServiceWand support multiple service lines?"
          }
        },
        {
          "code": "FAQ_1_ANSWER",
          "type": "LOCALIZED_STRING_SS",
          "nls": {
            "en": {
              "NAME": "ANSWER"
            }
          },
          "value": {
            "en": "Yes. ServiceWand is designed for teams that share scheduling, dispatching, routing, billing, and reporting foundations across multiple service models."
          }
        }
      ]
    },
    {
      "code": "FAQ_2",
      "nls": {
        "en": {
          "NAME": "Does ServiceWand replace a CRM?"
        }
      },
      "templateLanguage": "JTE",
      "parent": {
        "code": "FAQ"
      },
      "children": [],
      "head": "",
      "html": "<details class=\"faq-item\" data-faq-slot=\"02\">\n  <summary class=\"faq-q\"><span class=\"faq-q-text\">${FAQ_2_QUESTION@LOCALIZED_STRING_SS}</span><span class=\"faq-q-toggle\" aria-hidden=\"true\"><svg width=\"11\" height=\"11\" viewBox=\"0 0 11 11\" fill=\"none\"><path d=\"M5.5 1v9M1 5.5h9\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg></span></summary>\n  <div class=\"faq-a\">${FAQ_2_ANSWER@LOCALIZED_STRING_SS}</div>\n</details>",
      "css": "",
      "javascript": "",
      "parameters": [
        {
          "code": "FAQ_2_QUESTION",
          "type": "LOCALIZED_STRING_SS",
          "nls": {
            "en": {
              "NAME": "QUESTION"
            }
          },
          "value": {
            "en": "Does ServiceWand replace a CRM?"
          }
        },
        {
          "code": "FAQ_2_ANSWER",
          "type": "LOCALIZED_STRING_SS",
          "nls": {
            "en": {
              "NAME": "ANSWER"
            }
          },
          "value": {
            "en": "It can own field-service operational CRM workflows or integrate with an existing CRM, depending on how your organization is structured."
          }
        }
      ]
    },
    {
      "code": "FAQ_3",
      "nls": {
        "en": {
          "NAME": "Can crews use ServiceWand from the field?"
        }
      },
      "templateLanguage": "JTE",
      "parent": {
        "code": "FAQ"
      },
      "children": [],
      "head": "",
      "html": "<details class=\"faq-item\" data-faq-slot=\"03\">\n  <summary class=\"faq-q\"><span class=\"faq-q-text\">${FAQ_3_QUESTION@LOCALIZED_STRING_SS}</span><span class=\"faq-q-toggle\" aria-hidden=\"true\"><svg width=\"11\" height=\"11\" viewBox=\"0 0 11 11\" fill=\"none\"><path d=\"M5.5 1v9M1 5.5h9\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg></span></summary>\n  <div class=\"faq-a\">${FAQ_3_ANSWER@LOCALIZED_STRING_SS}</div>\n</details>",
      "css": "",
      "javascript": "",
      "parameters": [
        {
          "code": "FAQ_3_QUESTION",
          "type": "LOCALIZED_STRING_SS",
          "nls": {
            "en": {
              "NAME": "QUESTION"
            }
          },
          "value": {
            "en": "Can crews use ServiceWand from the field?"
          }
        },
        {
          "code": "FAQ_3_ANSWER",
          "type": "LOCALIZED_STRING_SS",
          "nls": {
            "en": {
              "NAME": "ANSWER"
            }
          },
          "value": {
            "en": "Yes. Mobile workflows keep technicians connected to job details, customer history, notes, photos, signatures, and billing steps."
          }
        }
      ]
    },
    {
      "code": "FAQ_4",
      "nls": {
        "en": {
          "NAME": "Is this only for one vertical?"
        }
      },
      "templateLanguage": "JTE",
      "parent": {
        "code": "FAQ"
      },
      "children": [],
      "head": "",
      "html": "<details class=\"faq-item\" data-faq-slot=\"04\">\n  <summary class=\"faq-q\"><span class=\"faq-q-text\">${FAQ_4_QUESTION@LOCALIZED_STRING_SS}</span><span class=\"faq-q-toggle\" aria-hidden=\"true\"><svg width=\"11\" height=\"11\" viewBox=\"0 0 11 11\" fill=\"none\"><path d=\"M5.5 1v9M1 5.5h9\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg></span></summary>\n  <div class=\"faq-a\">${FAQ_4_ANSWER@LOCALIZED_STRING_SS}</div>\n</details>",
      "css": "",
      "javascript": "",
      "parameters": [
        {
          "code": "FAQ_4_QUESTION",
          "type": "LOCALIZED_STRING_SS",
          "nls": {
            "en": {
              "NAME": "QUESTION"
            }
          },
          "value": {
            "en": "Is this only for one vertical?"
          }
        },
        {
          "code": "FAQ_4_ANSWER",
          "type": "LOCALIZED_STRING_SS",
          "nls": {
            "en": {
              "NAME": "ANSWER"
            }
          },
          "value": {
            "en": "No. The same operating model can support snow removal, HVAC, lawn care, cleaning, plumbing, electrical, pest control, and other field service operations."
          }
        }
      ]
    }
