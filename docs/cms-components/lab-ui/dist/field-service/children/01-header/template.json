  "html": "<!-- lab-ui block · header.sw-default\n     Canonical header for ALL ServiceWand pages.\n     Brand + multi-level nav + locale + ring CTA + burger.\n     Each nav item declares its kind via data-kind:\n       link     · plain anchor                                        (Pricing, Customers, ...)\n       dropdown · single-column panel of links                         (Resources)\n       mega     · multi-column panel with section headings + links     (Platform, Verticals)\n     One renderer / one CSS file handles all three.\n     Light theme (sw tokens).\n     Composes: cta.btn-primary-ring + language.sw-locale-dropdown.\n     Optional breadcrumb chip is owned here so header + breadcrumb stay\n     a single source of truth.\n-->\n<header class=\"header header--default\" role=\"banner\" data-block=\"header.sw-default\">\n  <div class=\"container\">\n    <div class=\"header-inner\">\n\n      <a class=\"header-logo\" href=\"${HEADER_BRAND_HREF@STRING}\" aria-label=\"ServiceWand\">\n        <svg viewBox=\"0 0 33 31\" width=\"22\" height=\"22\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M25.6 1.7l1.9 4.7 4.8 1.9-4.8 1.9-1.9 4.7-1.9-4.7L19 8.3l4.8-1.9 1.9-4.7zM8.3 0l2.3 5.9 6 2.3-6 2.3L8.3 16.5 5.9 10.6 0 8.3l5.9-2.3L8.3 0zM25.6 17.5l1.4 3.6 3.7 1.4-3.7 1.4-1.4 3.6-1.4-3.6-3.6-1.4 3.6-1.4 1.4-3.6zM20.4 13.5c.2.2.3.4.3.7s-.1.5-.3.7c-.2.3-.4.5-.7.8-2 2.3-3.9 4.7-6 6.9-2.1 2.2-4.3 4.4-6.4 6.6-.2.2-.5.5-.7.7-.4.4-.8.6-1.3.6-.5 0-1-.2-1.3-.6-.4-.4-.6-.9-.6-1.4 0-.5.2-1 .6-1.3.3-.2.5-.5.8-.7C7 24.4 9.1 22.2 11.3 20.1c2.2-2.1 4.6-4 6.9-6 .3-.2.5-.4.8-.6.2-.2.5-.3.7-.3.3 0 .5.1.7.3z\" fill=\"currentColor\"/>\n        </svg>\n        <span class=\"header-logo-text\">${HEADER_BRAND_NAME@LOCALIZED_STRING_SS}</span>\n      </a>\n\n      <nav class=\"header-nav\" aria-label=\"Primary\" data-nav>\n        <!--\n          Each <li> declares its kind. CMS generator emits the right\n          inner markup based on the kind. Unfilled slots auto-hide.\n\n          item kinds:\n            link      · single <a class=\"nav-link\">\n            dropdown  · trigger + <ul class=\"nav-panel nav-panel--list\">\n            mega      · trigger + <div class=\"nav-panel nav-panel--mega\"> with <section> columns\n        -->\n\n        <!-- 1 · MEGA — Platform -->\n        <div class=\"nav-item\" data-kind=\"mega\" data-nav-item>\n          <button class=\"nav-link nav-trigger\" type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">\n            ${HEADER_ITEM_1_LABEL@LOCALIZED_STRING_SS}\n            <svg class=\"nav-chev\" width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M1 1l4 4 4-4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n            </svg>\n          </button>\n          <div class=\"nav-panel nav-panel--mega\" role=\"menu\">\n            <section class=\"nav-mega-col\">\n              <h4 class=\"nav-mega-title\">${HEADER_ITEM_1_COL_1_TITLE@LOCALIZED_STRING_SS}</h4>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${HEADER_ITEM_1_COL_1_LINK_1_HREF@STRING}\">${HEADER_ITEM_1_COL_1_LINK_1_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${HEADER_ITEM_1_COL_1_LINK_2_HREF@STRING}\">${HEADER_ITEM_1_COL_1_LINK_2_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${HEADER_ITEM_1_COL_1_LINK_3_HREF@STRING}\">${HEADER_ITEM_1_COL_1_LINK_3_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${HEADER_ITEM_1_COL_1_LINK_4_HREF@STRING}\">${HEADER_ITEM_1_COL_1_LINK_4_LABEL@LOCALIZED_STRING_SS}</a>\n            </section>\n            <section class=\"nav-mega-col\">\n              <h4 class=\"nav-mega-title\">${HEADER_ITEM_1_COL_2_TITLE@LOCALIZED_STRING_SS}</h4>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${HEADER_ITEM_1_COL_2_LINK_1_HREF@STRING}\">${HEADER_ITEM_1_COL_2_LINK_1_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${HEADER_ITEM_1_COL_2_LINK_2_HREF@STRING}\">${HEADER_ITEM_1_COL_2_LINK_2_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${HEADER_ITEM_1_COL_2_LINK_3_HREF@STRING}\">${HEADER_ITEM_1_COL_2_LINK_3_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${HEADER_ITEM_1_COL_2_LINK_4_HREF@STRING}\">${HEADER_ITEM_1_COL_2_LINK_4_LABEL@LOCALIZED_STRING_SS}</a>\n            </section>\n          </div>\n        </div>\n\n        <!-- 2 · MEGA — Industries -->\n        <div class=\"nav-item\" data-kind=\"mega\" data-nav-item>\n          <button class=\"nav-link nav-trigger\" type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">\n            ${HEADER_ITEM_2_LABEL@LOCALIZED_STRING_SS}\n            <svg class=\"nav-chev\" width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M1 1l4 4 4-4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n            </svg>\n          </button>\n          <div class=\"nav-panel nav-panel--mega\" role=\"menu\">\n            <section class=\"nav-mega-col\">\n              <h4 class=\"nav-mega-title\">${HEADER_ITEM_2_COL_1_TITLE@LOCALIZED_STRING_SS}</h4>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${HEADER_ITEM_2_COL_1_LINK_1_HREF@STRING}\">${HEADER_ITEM_2_COL_1_LINK_1_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${HEADER_ITEM_2_COL_1_LINK_2_HREF@STRING}\">${HEADER_ITEM_2_COL_1_LINK_2_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${HEADER_ITEM_2_COL_1_LINK_3_HREF@STRING}\">${HEADER_ITEM_2_COL_1_LINK_3_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${HEADER_ITEM_2_COL_1_LINK_4_HREF@STRING}\">${HEADER_ITEM_2_COL_1_LINK_4_LABEL@LOCALIZED_STRING_SS}</a>\n            </section>\n            <section class=\"nav-mega-col\">\n              <h4 class=\"nav-mega-title\">${HEADER_ITEM_2_COL_2_TITLE@LOCALIZED_STRING_SS}</h4>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${HEADER_ITEM_2_COL_2_LINK_1_HREF@STRING}\">${HEADER_ITEM_2_COL_2_LINK_1_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${HEADER_ITEM_2_COL_2_LINK_2_HREF@STRING}\">${HEADER_ITEM_2_COL_2_LINK_2_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${HEADER_ITEM_2_COL_2_LINK_3_HREF@STRING}\">${HEADER_ITEM_2_COL_2_LINK_3_LABEL@LOCALIZED_STRING_SS}</a>\n              <a class=\"nav-mega-link\" role=\"menuitem\" href=\"${HEADER_ITEM_2_COL_2_LINK_4_HREF@STRING}\">${HEADER_ITEM_2_COL_2_LINK_4_LABEL@LOCALIZED_STRING_SS}</a>\n            </section>\n          </div>\n        </div>\n\n        <!-- 3 · LINK — How It Works -->\n        <div class=\"nav-item\" data-kind=\"link\" data-nav-item>\n          <a class=\"nav-link\" href=\"${HEADER_ITEM_3_HREF@STRING}\">${HEADER_ITEM_3_LABEL@LOCALIZED_STRING_SS}</a>\n        </div>\n\n        <!-- 4 · LINK — Partners -->\n        <div class=\"nav-item\" data-kind=\"link\" data-nav-item>\n          <a class=\"nav-link\" href=\"${HEADER_ITEM_4_HREF@STRING}\">${HEADER_ITEM_4_LABEL@LOCALIZED_STRING_SS}</a>\n        </div>\n\n        <!-- 5 · DROPDOWN — Resources -->\n        <div class=\"nav-item\" data-kind=\"dropdown\" data-nav-item>\n          <button class=\"nav-link nav-trigger\" type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">\n            ${HEADER_ITEM_5_LABEL@LOCALIZED_STRING_SS}\n            <svg class=\"nav-chev\" width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M1 1l4 4 4-4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n            </svg>\n          </button>\n          <ul class=\"nav-panel nav-panel--list\" role=\"menu\">\n            <li><a class=\"nav-list-link\" role=\"menuitem\" href=\"${HEADER_ITEM_5_LINK_1_HREF@STRING}\">${HEADER_ITEM_5_LINK_1_LABEL@LOCALIZED_STRING_SS}</a></li>\n            <li><a class=\"nav-list-link\" role=\"menuitem\" href=\"${HEADER_ITEM_5_LINK_2_HREF@STRING}\">${HEADER_ITEM_5_LINK_2_LABEL@LOCALIZED_STRING_SS}</a></li>\n            <li><a class=\"nav-list-link\" role=\"menuitem\" href=\"${HEADER_ITEM_5_LINK_3_HREF@STRING}\">${HEADER_ITEM_5_LINK_3_LABEL@LOCALIZED_STRING_SS}</a></li>\n            <li><a class=\"nav-list-link\" role=\"menuitem\" href=\"${HEADER_ITEM_5_LINK_4_HREF@STRING}\">${HEADER_ITEM_5_LINK_4_LABEL@LOCALIZED_STRING_SS}</a></li>\n          </ul>\n        </div>\n\n      </nav>\n\n      <div class=\"header-actions\">\n        <!-- Slot: locale (block: language.sw-locale-dropdown) -->\n        <div class=\"locale-selector\" data-block=\"language.sw-locale-dropdown\">\n          <button class=\"locale-trigger\" aria-haspopup=\"listbox\" aria-expanded=\"false\">\n            <div class=\"locale-trigger-left\">\n              <svg class=\"locale-chevron\" width=\"13\" height=\"8\" viewBox=\"0 0 13 8\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M0.672729 0.73999L6.17273 5.73999L11.6727 0.73999\" stroke=\"currentColor\" stroke-width=\"2\"/>\n              </svg>\n              <span class=\"locale-trigger-label\">${HEADER_LOCALE_LABEL@LOCALIZED_STRING_SS}</span>\n            </div>\n          </button>\n          <div class=\"locale-dropdown\" role=\"listbox\" aria-label=\"Select language\">\n            <ul class=\"locale-list\"></ul>\n          </div>\n        </div>\n\n        <!-- Slot: primary CTA (block: cta.btn-primary-ring) -->\n        <a class=\"btn btn-primary btn-primary-ring header-cta\" href=\"${HEADER_CTA_HREF@STRING}\">\n          <svg class=\"btn-star\" width=\"16\" height=\"16\" viewBox=\"0 0 21 21\" fill=\"currentColor\" aria-hidden=\"true\">\n            <path d=\"M10.5 0L13.4698 7.53015L21 10.5L13.4698 13.4698L10.5 21L7.53015 13.4698L0 10.5L7.53015 7.53015L10.5 0Z\"/>\n          </svg>\n          ${HEADER_CTA_LABEL@LOCALIZED_STRING_SS}\n        </a>\n\n        <button class=\"burger\" aria-label=\"Open menu\" aria-expanded=\"false\">\n          <span></span><span></span><span></span>\n        </button>\n      </div>\n\n    </div>\n  </div>\n</header>\n\n<div class=\"bc-chip\" data-block=\"header.sw-default-breadcrumb\" role=\"navigation\" aria-label=\"Breadcrumb\">\n  <a class=\"bc-link bc-root\" href=\"${HEADER_BREADCRUMB_ROOT_HREF@STRING}\">${HEADER_BREADCRUMB_ROOT_LABEL@LOCALIZED_STRING_SS}</a>\n  <span class=\"bc-sep\" data-sep-for=\"mid_1\" aria-hidden=\"true\">&gt;</span>\n  <a class=\"bc-link\" data-mid=\"1\" href=\"${HEADER_BREADCRUMB_MID_1_HREF@STRING}\">${HEADER_BREADCRUMB_MID_1_LABEL@LOCALIZED_STRING_SS}</a>\n  <span class=\"bc-sep\" data-sep-for=\"mid_2\" aria-hidden=\"true\">&gt;</span>\n  <a class=\"bc-link\" data-mid=\"2\" href=\"${HEADER_BREADCRUMB_MID_2_HREF@STRING}\">${HEADER_BREADCRUMB_MID_2_LABEL@LOCALIZED_STRING_SS}</a>\n  <span class=\"bc-sep\" data-sep-for=\"current\" aria-hidden=\"true\">&gt;</span>\n  <span class=\"bc-current\" aria-current=\"page\">${HEADER_BREADCRUMB_CURRENT_LABEL@LOCALIZED_STRING_SS}</span>\n</div>\n",
