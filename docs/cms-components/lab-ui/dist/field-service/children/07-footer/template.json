  "html": "<!-- lab-ui block · footer.sw-default\n     ServiceWand canonical site footer. Dark surface. 3-column grid\n     (brand+tagline+address / 5-nav / socials+emails) + legal bottom row.\n     Param contract: see block.json.\n-->\n<footer class=\"footer\" role=\"contentinfo\">\n  <div class=\"container footer-container\">\n    <div class=\"footer-top\">\n\n      <div class=\"footer-brand\">\n        <div class=\"footer-brand-head\">\n          <a href=\"${FOOTER_BRAND_HREF@STRING}\" class=\"footer-logo footer-logo--2xl\" aria-label=\"ServiceWand\">\n            <svg viewBox=\"0 0 33 31\" width=\"32\" height=\"32\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M25.6 1.7l1.9 4.7 4.8 1.9-4.8 1.9-1.9 4.7-1.9-4.7L19 8.3l4.8-1.9 1.9-4.7zM8.3 0l2.3 5.9 6 2.3-6 2.3L8.3 16.5 5.9 10.6 0 8.3l5.9-2.3L8.3 0zM25.6 17.5l1.4 3.6 3.7 1.4-3.7 1.4-1.4 3.6-1.4-3.6-3.6-1.4 3.6-1.4 1.4-3.6zM20.4 13.5c.2.2.3.4.3.7s-.1.5-.3.7c-.2.3-.4.5-.7.8-2 2.3-3.9 4.7-6 6.9-2.1 2.2-4.3 4.4-6.4 6.6-.2.2-.5.5-.7.7-.4.4-.8.6-1.3.6-.5 0-1-.2-1.3-.6-.4-.4-.6-.9-.6-1.4 0-.5.2-1 .6-1.3.3-.2.5-.5.8-.7C7 24.4 9.1 22.2 11.3 20.1c2.2-2.1 4.6-4 6.9-6 .3-.2.5-.4.8-.6.2-.2.5-.3.7-.3.3 0 .5.1.7.3z\" fill=\"currentColor\"/>\n            </svg>\n            <span>${FOOTER_BRAND_NAME@LOCALIZED_STRING_SS}</span>\n          </a>\n        </div>\n        <p class=\"footer-tagline\">${FOOTER_TAGLINE@LOCALIZED_STRING_SS}</p>\n        <address class=\"footer-address\">\n          <p><strong>${FOOTER_ADDRESS_LINE_1@LOCALIZED_STRING_SS}</strong></p>\n          <p>${FOOTER_ADDRESS_LINE_2@LOCALIZED_STRING_SS}</p>\n          <p>${FOOTER_ADDRESS_LINE_3@LOCALIZED_STRING_SS}</p>\n          <p>${FOOTER_ADDRESS_LINE_4@LOCALIZED_STRING_SS}</p>\n        </address>\n      </div>\n\n      <nav class=\"footer-nav\" aria-label=\"Footer navigation\">\n        <a class=\"footer-nav-link\" href=\"${FOOTER_NAV_1_HREF@STRING}\">${FOOTER_NAV_1_LABEL@LOCALIZED_STRING_SS}</a>\n        <a class=\"footer-nav-link\" href=\"${FOOTER_NAV_2_HREF@STRING}\">${FOOTER_NAV_2_LABEL@LOCALIZED_STRING_SS}</a>\n        <a class=\"footer-nav-link\" href=\"${FOOTER_NAV_3_HREF@STRING}\">${FOOTER_NAV_3_LABEL@LOCALIZED_STRING_SS}</a>\n        <a class=\"footer-nav-link\" href=\"${FOOTER_NAV_4_HREF@STRING}\">${FOOTER_NAV_4_LABEL@LOCALIZED_STRING_SS}</a>\n        <a class=\"footer-nav-link\" href=\"${FOOTER_NAV_5_HREF@STRING}\">${FOOTER_NAV_5_LABEL@LOCALIZED_STRING_SS}</a>\n      </nav>\n\n      <div class=\"footer-contacts\">\n        <div class=\"footer-socials\">\n          <a class=\"footer-social-link\" href=\"${FOOTER_SOCIAL_LINKEDIN@STRING}\" aria-label=\"LinkedIn\">\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43c-1.14 0-2.07-.93-2.07-2.07s.93-2.07 2.07-2.07 2.07.93 2.07 2.07-.93 2.07-2.07 2.07zM7.12 20.45H3.56V9h3.56v11.45z\"/></svg>\n          </a>\n          <a class=\"footer-social-link\" href=\"${FOOTER_SOCIAL_GITHUB@STRING}\" aria-label=\"GitHub\">\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.72.08-.72 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.23-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23.96-.27 1.98-.4 3-.41 1.02.01 2.04.14 3 .41 2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.82 1.1.82 2.22 0 1.6-.02 2.89-.02 3.29 0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z\"/></svg>\n          </a>\n          <a class=\"footer-social-link\" href=\"${FOOTER_SOCIAL_YOUTUBE@STRING}\" aria-label=\"YouTube\">\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M23.5 6.5a3 3 0 0 0-2.1-2.1C19.5 4 12 4 12 4s-7.5 0-9.4.4A3 3 0 0 0 .5 6.5C.1 8.4.1 12 .1 12s0 3.6.4 5.5a3 3 0 0 0 2.1 2.1c1.9.4 9.4.4 9.4.4s7.5 0 9.4-.4a3 3 0 0 0 2.1-2.1c.4-1.9.4-5.5.4-5.5s0-3.6-.4-5.5zM9.6 15.5v-7l6.3 3.5-6.3 3.5z\"/></svg>\n          </a>\n          <a class=\"footer-social-link\" href=\"${FOOTER_SOCIAL_X@STRING}\" aria-label=\"X\">\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M18.244 2H21.5l-7.5 8.57L23 22h-6.844l-5.36-7L4.66 22H1.4l8.04-9.17L1 2h7.02l4.84 6.4L18.244 2zm-1.2 18h1.86L7 4h-2L17.044 20z\"/></svg>\n          </a>\n        </div>\n        <div class=\"footer-emails\">\n          <div class=\"footer-email-group\">\n            <p class=\"footer-email-label\">${FOOTER_PARTNERSHIPS_LABEL@LOCALIZED_STRING_SS}</p>\n            <a class=\"footer-email-link\" href=\"mailto:${FOOTER_PARTNERSHIPS_EMAIL@STRING}\">${FOOTER_PARTNERSHIPS_EMAIL@STRING}</a>\n          </div>\n          <div class=\"footer-email-group\">\n            <p class=\"footer-email-label\">${FOOTER_SUPPORT_LABEL@LOCALIZED_STRING_SS}</p>\n            <a class=\"footer-email-link\" href=\"mailto:${FOOTER_SUPPORT_EMAIL@STRING}\">${FOOTER_SUPPORT_EMAIL@STRING}</a>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n    <div class=\"footer-bottom\">\n      <p class=\"footer-copy\">${FOOTER_COPYRIGHT@LOCALIZED_STRING_SS}</p>\n      <div class=\"footer-legal-mobile\">\n        <a class=\"footer-legal-link\" href=\"${FOOTER_LEGAL_1_HREF@STRING}\">${FOOTER_LEGAL_1_LABEL@LOCALIZED_STRING_SS}</a>\n        <a class=\"footer-legal-link\" href=\"${FOOTER_LEGAL_2_HREF@STRING}\">${FOOTER_LEGAL_2_LABEL@LOCALIZED_STRING_SS}</a>\n      </div>\n    </div>\n  </div>\n</footer>\n",
