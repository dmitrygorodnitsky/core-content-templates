  },
  {
    "code": "FAQ_TITLE",
    "type": "LOCALIZED_STRING_SS",
    "nls": {
      "en": {
        "NAME": "TITLE"
      }
    },
    "value": {
      "en": "Frequently asked questions"
    }
  },
  {
    "code": "FAQ_LEDE",
    "type": "LOCALIZED_STRING_SS",
    "nls": {
      "en": {
        "NAME": "LEDE"
      }
    },
    "value": {
      "en": ""
    }
  },
  {
    "code": "FAQ_GROUP_1_TITLE",
    "type": "LOCALIZED_STRING_SS",
    "nls": {
      "en": {
        "NAME": "TITLE"
      }
    },
    "value": {
      "en": "Field service basics"
    }
  },
  {
    "code": "FAQ_1_QUESTION",
    "type": "LOCALIZED_STRING_SS",
    "nls": {
      "en": {
        "NAME": "QUESTION"
      }
    },
    "value": {
      "en": "What is field service software?"
    }
  },
  {
    "code": "FAQ_1_ANSWER",
    "type": "LOCALIZED_STRING_SS",
    "nls": {
      "en": {
        "NAME": "ANSWER"
      }
    },
    "value": {
      "en": "Field service software helps businesses manage work performed outside the office. It connects scheduling, dispatching, work orders, mobile technicians, customer information, routing, invoicing, payments, reporting, and job status updates in one operational system."
    }
  },
  {
    "code": "FAQ_2_QUESTION",
    "type": "LOCALIZED_STRING_SS",
    "nls": {
      "en": {
        "NAME": "QUESTION"
      }
    },
    "value": {
      "en": "What does field service management software do?"
    }
  },
  {
    "code": "FAQ_2_ANSWER",
    "type": "LOCALIZED_STRING_SS",
    "nls": {
      "en": {
        "NAME": "ANSWER"
      }
    },
    "value": {
      "en": "Field service management software coordinates the complete service lifecycle: service requests, scheduling, assigning technicians, dispatching crews, tracking work orders, managing customer history, collecting field updates, creating invoices, and reporting on performance."
    }
  },
  {
    "code": "FAQ_GROUP_2_TITLE",
    "type": "LOCALIZED_STRING_SS",
    "nls": {
      "en": {
        "NAME": "TITLE"
      }
    },
    "value": {
      "en": "Platform fit"
    }
  },
  {
    "code": "FAQ_3_QUESTION",
    "type": "LOCALIZED_STRING_SS",
    "nls": {
      "en": {
        "NAME": "QUESTION"
      }
    },
    "value": {
      "en": "What makes good field service software?"
    }
  },
  {
    "code": "FAQ_3_ANSWER",
    "type": "LOCALIZED_STRING_SS",
    "nls": {
      "en": {
        "NAME": "ANSWER"
      }
    },
    "value": {
      "en": "A strong platform balances operational depth with ease of use for field teams. It should include real-time scheduling, dispatching, mobile workflows, customer history, automated communication, invoicing, payments, reporting, integrations, and scalability."
    }
  },
  {
    "code": "FAQ_4_QUESTION",
    "type": "LOCALIZED_STRING_SS",
    "nls": {
      "en": {
        "NAME": "QUESTION"
      }
    },
    "value": {
      "en": "Can field service software support multiple industries?"
    }
  },
  {
    "code": "FAQ_4_ANSWER",
    "type": "LOCALIZED_STRING_SS",
    "nls": {
      "en": {
        "NAME": "ANSWER"
      }
    },
    "value": {
      "en": "Yes. Many field service industries share the same operational foundation: scheduling, dispatching, routing, mobile work, customer management, billing, reporting, and workforce coordination."
    }
  },
  {
    "code": "CTA_EYEBROW",
    "type": "LOCALIZED_STRING_SS",
    "nls": {
      "en": {
        "NAME": "EYEBROW"
      }
    },
    "value": {
      "en": "Build the next layer"
    }
  },
  {
    "code": "CTA_TITLE",
    "type": "LOCALIZED_STRING_SS",
    "nls": {
      "en": {
        "NAME": "TITLE"
      }
    },
    "value": {
      "en": "Field service operations are becoming more complex, distributed, and operationally demanding. ServiceWand creates the operational foundation for scalable field service management."
    }
  },
