    "FEATURE_1_TITLE": {
      "en": "Field Service Scheduling Software"
    },
    "FEATURE_1_BODY": {
      "en": "Plan jobs, manage appointments, assign technicians, account for route context, and adjust schedules as priorities change."
    },
    "FEATURE_2_TITLE": {
      "en": "Field Service Dispatch Software"
    },
    "FEATURE_2_BODY": {
      "en": "Assign the right technician, crew, vehicle, or resource to the right job while coordinating route changes, emergency requests, job status updates, and office-to-field communication."
    },
    "FEATURE_3_TITLE": {
      "en": "Mobile Field Service Software"
    },
    "FEATURE_3_BODY": {
      "en": "Give field teams job context, customer history, notes, photos, signatures, and invoices from a mobile workflow."
    },
    "FEATURE_4_TITLE": {
      "en": "Field Service CRM"
    },
    "FEATURE_4_BODY": {
      "en": "Keep properties, contacts, service history, contracts, and customer communication connected to the work being performed."
    },
    "FEATURE_5_TITLE": {
      "en": "Field Service Billing Software"
    },
    "FEATURE_5_BODY": {
      "en": "Turn completed work into invoices and operational reporting without re-entering data across systems."
    },
    "FEATURES_EYEBROW": {
      "en": "Features"
    },
    "FEATURES_TITLE": {
      "en": "Features"
    },
    "FEATURES_LEDE": {
      "en": "ServiceWand includes the operational features field service businesses need to coordinate work from request to completion, without forcing every team into a rigid workflow. Unlike narrow field service software solutions that handle only one part of the workflow, ServiceWand connects scheduling, dispatching, mobile work, customer history, billing, reporting, and automation in one operational platform."
    },
