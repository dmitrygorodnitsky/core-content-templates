{
  "$schema": "lab-ui/block@1",
  "id": "verticals.glyph-grid-20-slots",
  "category": "10-verticals-grid",
  "title": "Verticals grid · photo-card catalog",
  "description": "Signature industry catalog. 20 CMS-addressable slots in a responsive photo-card grid. Each visible card has a media placeholder/photo slot, title, description, URL href, and status treatment. Lorem Ipsum ships live; the other default verticals ship coming soon with a waitlist CTA. Seven spare slots are hidden until an admin fills the title.",
  "canonical": true,
  "theme": "light",
  "source": {
    "primary": "/Users/imighty/Downloads/Lorem ipsum (2)/src/kit/catalog-compare.jsx (CardCatalog)",
    "extensibility_pattern": "20 numbered slots with [hidden] spare cards",
    "decision": "PM lock 2026-05-25 — verticals grid uses Lorem ipsum photo-card catalog pattern, not small SVG glyph cards"
  },
  "depends_on": {
    "tokens": [
      "--color-bg",
      "--color-text",
      "--color-heading",
      "--color-gray-blue",
      "--color-gray-second",
      "--cta-secondary-fill",
      "--cta-secondary-color",
      "--cta-accent",
      "--font-family",
      "--font-mono",
      "--container-width",
      "--container-padding-x",
      "--radius-card",
      "--transition-duration"
    ],
    "other_blocks": []
  },
  "background": {
    "optional": true,
    "default": "none",
    "modes": [
      "none",
      "gradient",
      "image"
    ],
    "role": "decorative section background",
    "image": {
      "recommended_size": "2880 × 1800",
      "fit": "cover",
      "position": "center",
      "alt": ""
    },
    "gradient": {
      "recommended": "subtle neutral/accent gradient only; do not use freeform decorative orbs"
    },
    "url_params": {
      "mode": "bg",
      "image": "bgImage",
      "gradient": "bgGradient"
    },
    "notes": [
      "Full-width industries grid background; separate from per-card media slots.",
      "Background is decorative and must not replace content media slots or block copy.",
      "Preview in any supported harness with ?bg=gradient or ?bg=image&bgImage=<encoded-url>."
    ]
  },
