{
  "$schema": "lab-ui/block@1",
  "id": "comparison.three-col-with-mobile-cards",
  "category": "07-comparison",
  "title": "Comparison · the platform matrix",
  "description": "the platform.com-style comparison matrix with six external platform columns, status icons, a highlighted the platform column, and stacked mobile cards below 860px.",
  "canonical": true,
  "theme": "light",
  "source": {
    "primary": "https://example.com/ comparison section",
    "adapted_from": "Live the platform comparison matrix, normalized as a lab-ui block contract",
    "decision": "PM lock 2026-05-25 — comparison should match the platform matrix, not the old 3-way FSM table"
  },
  "depends_on": {
    "tokens": [
      "--color-bg",
      "--color-text",
      "--color-heading",
      "--color-gray-blue",
      "--cta-secondary-fill",
      "--font-family",
      "--font-mono",
      "--container-width",
      "--container-padding-x",
      "--radius-card-sm",
      "--type-h2-size",
      "--type-h2-weight",
      "--type-lead-size"
    ],
    "other_blocks": []
  },
  "background": {
    "optional": true,
    "default": "none",
    "modes": [
      "none",
      "gradient",
      "image"
    ],
    "role": "decorative section background",
    "image": {
      "recommended_size": "2880 × 1400",
      "fit": "cover",
      "position": "center",
      "alt": ""
    },
    "gradient": {
      "recommended": "subtle neutral/accent gradient only; do not use freeform decorative orbs"
    },
    "url_params": {
      "mode": "bg",
      "image": "bgImage",
      "gradient": "bgGradient"
    },
    "notes": [
      "Full-width comparison section background; gradient mode preferred over image because the table already has strong surface styling.",
      "Background is decorative and must not replace content media slots or block copy.",
      "Preview in any supported harness with ?bg=gradient or ?bg=image&bgImage=<encoded-url>."
    ]
  },
