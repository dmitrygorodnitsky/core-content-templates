{
  "$schema": "lab-ui/tokens@1",
  "source": "example.com (source tokens) + JetBrains Mono additive (v5)",
  "theme": "light",
  "groups": {
    "color": {
      "raw": {
        "color-black": "#1B1D25",
        "color-white": "#FFFFFF",
        "color-gray": "#BEC5D3",
        "color-gray-second": "#5C6474",
        "color-gray-blue": "#97A2B8",
        "color-gray-light": "#D9D9D9",
        "color-cyan": "#6BEAF9",
        "color-blue": "#4F95FF",
        "color-red": "#FF6C56",
        "color-green": "#7DDE8E",
        "color-orange": "#FFA72C",
        "color-magenta": "#EF5CFF",
        "color-black-bg": "#17171B",
        "color-gray-bg": "#F9F9F9"
      },
      "semantic-light": {
        "color-bg": "var(--color-white)",
        "color-text": "var(--color-gray-second)",
        "color-heading": "var(--color-black)",
        "color-link": "var(--color-black)",
        "card-bg": "var(--color-gray-bg)"
      }
    },
    "typography": {
      "font-family": "\"Vela Sans\", sans-serif",
      "font-mono": "\"JetBrains Mono\", ui-monospace, monospace",
      "scale": {
        "h1": { "size": "clamp(2.25rem, 5.2vw, 5rem)", "weight": 500, "tracking": "-0.025em" },
        "h2": { "size": "clamp(1.75rem, 3.4vw, 3.125rem)", "weight": 600, "tracking": "-0.022em" },
        "h3": { "size": "clamp(1.125rem, 1.6vw, 1.5625rem)", "weight": 600, "tracking": "-0.015em" },
        "h4": { "size": "1.125rem", "weight": 600 },
        "lead": { "size": "clamp(1rem, 1.25vw, 1.25rem)", "weight": 400 },
        "body": { "size": "1rem", "leading": 1.55 },
        "eyebrow": { "size": "0.8125rem", "tracking": "0.12em", "case": "uppercase" }
      }
    },
    "layout": {
      "container-width": "105rem",
      "container-padding-x": "1.875rem",
      "header-height": "4.6875rem"
    },
    "radii": {
      "radius-pill": "6.25rem",
      "radius-card": "1.25rem",
      "radius-card-sm": "0.9375rem"
    },
    "motion": {
      "transition-duration": "0.4s"
    },
    "gradient": {
      "cta-ring": "linear-gradient(250deg, rgba(107,237,249,0) 4.98%, #6bedf9 37.35%, #ffa72c 72.51%, rgba(239,92,255,0) 96.41%)",
      "source": "v5 (locked 2026-05-21)"
    }
  }
}
