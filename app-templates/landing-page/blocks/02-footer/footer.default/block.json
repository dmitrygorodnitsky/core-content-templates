{
  "$schema": "lab-ui/block@1",
  "id": "footer.default",
  "category": "02-footer",
  "title": "Footer · canonical",
  "description": "Dark site footer used across example.com and all the platform landings. 3-column grid: brand+tagline+address / 5-link nav / socials+emails. Bottom row: copyright + legal links. Used regardless of page theme (light/dark) — the footer itself is always dark.",
  "canonical": true,
  "theme": "dark-always",
  "source": {
    "primary": "tmp/sw-footer.html",
    "css": "tmp/source tokens (.footer-*)"
  },
  "depends_on": {
    "tokens": [
      "--color-black-bg",
      "--color-white",
      "--color-gray-light",
      "--color-gray-blue",
      "--font-family",
      "--font-mono",
      "--container-width",
      "--container-padding-x",
      "--transition-duration"
    ],
    "other_blocks": []
  },
  "params": [
