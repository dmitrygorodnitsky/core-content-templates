  "loadOrder": [
    {
      "title": "1. Organizations",
      "detail": "Reuse WINTER_SERVICES and WINTER_SERVICES_CA. Import SERVICEWAND and SERVICEWAND_SOFTWARE from dev-1. Reuse the existing LSRC by its actual code; retain its type and parent."
    },
    {
      "title": "2. Types",
      "detail": "Load base definitions and parent types first. Resolve references by entity kind and code; never copy dev IDs. Attach workflows in a second pass."
    },
    {
      "title": "3. Scripts",
      "detail": "Use the consolidated local package and remap permissions and configured organization references. Keep external dependencies available."
    },
    {
      "title": "4. Workflow links",
      "detail": "Import workflows and attach them to types; restore transitions, actions and permissions. Scheduled-task replacement verification is deferred."
    },
    {
      "title": "5. Configuration and catalog",
      "detail": "Load dictionaries, reports and products into their agreed organizations."
    },
    {
      "title": "6. Prices",
      "detail": "Load price definitions after products; ServiceWand to SERVICEWAND, Limitless to LSRC."
    },
    {
      "title": "7. Roles and environment",
      "detail": "Import selected roles into WINTER_SERVICES. Rename the portal role to CUSTOMER_PORTAL. Use dev-1 URL paths with the prod.servicewand.com host; verify the pages are deployed before launch."
    },
    {
      "title": "8. Schedules",
      "detail": "Import INVOICE_PAYMENT_REMINDERS and SNOW_VISIT_ORDERS disabled. Exclude the other two application schedules; do not enable payment."
    }
  ],
  "notes": [
