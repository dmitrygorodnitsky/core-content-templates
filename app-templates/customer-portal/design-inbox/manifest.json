    },
    {
      "id": "seo-cta",
      "factory": "SeoCta",
      "props": ["action (fixed id)", "label", "successLabel", "variant"],
      "status": "done",
      "wave": 8,
      "note": "data-state = idle|pending|success|error from state.seoCta[actionId]; state.seoCtaForce (dev toolbar 'cta' select) previews any state on all CTAs. Wave 11: CTA kinds services|pricing|products|signin map to HONEST NAVIGATION (nav.services / nav.pricing / nav.products / auth.gotoSignin) — those CTAs render NO lifecycle (data-state stays idle, unaffected by seoCtaForce)."
    },
    {
      "id": "seo-products-teaser",
      "factory": "SeoProductsTeaser (components/seo/SeoSections.js)",
      "props": ["cms.productsTeaser (eyebrow, title, sub, cta, note, codes[])", "pim.products[] (public fields only)"],
      "status": "done",
      "wave": 11,
      "states": ["ready", "loading", "empty"],
      "note": "Retail teaser between seo-pricing and seo-service-area (Calm Harbor release). Renders 3–4 cards from the repeated public PIM collection; per-vertical opt-in — the section is omitted when cms.productsTeaser is absent, other verticals unchanged. codes[] = CMS slot choosing featured catalog product codes. ONE action for the section CTA and every card: nav.products → existing public Shop route. Empty retail collection renders seo-products-teaser-empty (honest copy, CTA hidden, no invented products or sales claims). No cart, checkout, order, payment, booking command or success state on the public landing."
    },
    {
      "id": "seo-product-teaser-card",
      "factory": "inline in SeoProductsTeaser",
      "props": ["pim.products[] — code, name, shortDescription, displayPrice, optional image"],
      "status": "done",
      "wave": 11,
      "note": "Reuses the accepted product-card visual language (product-card classes) — NOT a second catalog-card system; no Add/cart button. data-product-code carries the source PIM product code. A missing public image keeps the accepted tinted-thumb art. Whole card fires nav.products."
    },
    {
      "id": "seo-products-teaser-empty",
      "factory": "inline in SeoProductsTeaser",
      "props": [],
      "status": "done",
      "wave": 11,
      "note": "Intentional empty state for an empty retail PIM collection (data-visual-id seo-products-teaser-empty, data-state no-data)."
    },
    {
      "id": "seo-media",
      "factory": "seoMedia (components/seo/SeoSections.js)",
      "props": ["cms.media.hero / cms.media.proof (src, alt, focal, label)"],
