{
  "product": "Aircove Customer Portal",
  "version": "wave-11 (modular / customer-portal-design)",
  "format": "no-build ES modules: source.html + styles/*.css (6) + src/**/*.js (~47) + data/",
  "runtime": "presentation-only. Business logic, API, auth, permissions, persistence are owned by Codex.",
  "entry": "customer-portal-design/source.html",
  "dataAttributes": {
    "data-route": "page / view id (matches scenarios.routes[].id)",
    "data-module": "reusable component id (matches components[].id)",
    "data-bind": "fixture field(s) the rendered value came from",
    "data-action": "user command name (matches actions[])",
    "data-state": "ui state on the element (ready|loading|empty|error|pending-action|drawer-open|mobile-navigation-open|active)",
    "data-visual-id": "stable id for screenshot parity / visual transfer",
    "data-dev-toolbar": "PREVIEW-ONLY harness; Codex strips elements carrying this"
  },
  "themingContract": {
    "mechanism": "declarative attributes on <html>",
    "attributes": {
      "data-theme": [
        "hvac",
        "snow",
        "lawn",
        "pool",
        "roofing",
        "pest",
        "health",
        "beauty"
      ],
      "data-mode": [
        "light",
        "dark"
      ]
    },
    "note": "data-theme (vertical) is CONFIG-DRIVEN — set once from deployment config, NOT a user control (the in-app theme picker was removed). data-mode (light/dark) stays a user toggle. All colors derive from CSS custom properties in styles.css; app.js only flips these two attributes."
  },
  "portalProfiles": {
    "mechanism": "config-driven by vertical (fixtures.profileFor maps theme -> profile). Sets nav set, primary action, whether the weather-operational Calendar is used, and cart visibility.",
    "profiles": {
      "onDemand": {
        "verticals": [
          "HVAC"
        ],
        "nav": [
          "orders.list",
          "care (vertical hub — 'Equipment')",
          "proposals.list",
          "services",
          "pricing",
          "products",
          "support"
        ],
        "primary": "booking.open (+ Book)",
        "weatherCalendar": false,
        "cart": true
      },
      "stormOps": {
        "verticals": [
          "Snow Removal",
          "Lawn & Garden",
          "Pool & Spa",
          "Roofing",
          "Pest Control"
        ],
        "nav": [
          "orders.list (Home)",
          "calendar",
          "care (vertical hub — label per vertical)",
          "proposals.list (Contracts)",
          "services",
          "activity",
          "support"
        ],
        "primary": "service.request (Request service)",
        "weatherCalendar": true,
        "cart": false
      },
      "appointments": {
        "verticals": [
          "Health",
          "Beauty"
        ],
        "nav": [
          "orders.list (Appointments)",
          "calendar (month grid)",
          "care (vertical hub — 'Care plan' / 'My routine')",
          "services",
          "pricing",
          "products",
          "support"
        ],
        "primary": "booking.open (+ Book)",
        "weatherCalendar": false,
        "cart": true,
        "note": "Wave 9. No weather triggers: these verticals set fixtures.themes[x].wt = null, which removes the Weather Trigger banner/panel and the weather feed item everywhere."
      }
    },
    "note": "Calendar renders StormCalendar (weather-operational) for stormOps and MonthCalendar for onDemand. StormCalendar derives service names + trigger copy from the active vertical, so one component serves all 5 weather-triggered verticals."
  },
