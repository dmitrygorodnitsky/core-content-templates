{
  "product": "Aircove Customer Portal",
  "version": "runtime-wave9-s1-control-plane",
  "format": "no-build ES modules: source.html + 6 stylesheets + 53 src JavaScript modules + data/fixtures.js",
  "fileInventory": {
    "stylesheets": 6,
    "srcJavaScript": 53,
    "runtimeJavaScript": 54
  },
  "runtime": "production transfer target. Business logic, API, auth, permissions, persistence are owned by Codex runtime stages.",
  "entry": "runtime/source.html",
  "dataAttributes": {
    "data-route": "page / view id (matches scenarios.routes[].id)",
    "data-module": "reusable component id (matches components[].id)",
    "data-bind": "fixture field(s) the rendered value came from",
    "data-action": "user command name (matches actions[])",
    "data-state": "UI state. Shared production grammar: ready|loading|empty|error|fallback|disabled|unauthorized|validation-error|pending-action|success-toast|drawer-open|mobile-navigation-open|active. Existing component/entity states such as auth-phone/auth-code, selected/current/on/off, and order/proposal/weather/service statuses remain defined by their component contracts and scenarios.json.",
    "data-visual-id": "stable id for screenshot parity / visual transfer"
  },
  "themingContract": {
    "mechanism": "declarative attributes on <html>",
    "attributes": {
      "data-theme": [
        "hvac",
        "snow",
        "lawn",
        "pool",
        "roofing",
        "pest",
        "health",
        "beauty"
      ],
      "data-mode": [
        "light",
        "dark"
      ]
    },
    "note": "data-theme is the validated visual skin from config.theme and controls CSS tokens only. config.vertical separately owns fixture/content/business behavior, weather capability, Care label, default profile, and orders. Neither axis is an end-user picker. data-mode (light/dark) remains a user toggle."
  },
  "portalProfiles": {
    "mechanism": "config.vertical selects verticalProfiles business/content facts and a portalProfiles default. config.theme selects visual CSS tokens only. Profiles set nav, primary action, calendar mode, cart visibility, and enabled modules; verticalProfiles supplies the Care label and weather capability.",
    "profiles": {
      "onDemand": {
        "verticals": [
          "HVAC"
        ],
        "nav": [
          { "key": "orders.list", "label": "Orders" },
          { "key": "care", "labelSource": "verticalProfiles.careNavLabel" },
          { "key": "proposals.list", "label": "Proposals" },
          { "key": "services", "label": "Services" },
          { "key": "pricing", "label": "Pricing" },
          { "key": "products", "label": "Products" },
          { "key": "support", "label": "Support" }
        ],
        "enabledModules": ["orders", "calendar", "activity", "proposals", "care", "services", "pricing", "products", "checkout", "profile", "support"],
        "primary": { "label": "+ Book", "action": "booking.open" },
        "weatherCalendar": false,
        "calendarVariant": "month",
        "showCart": true,
        "drawerTitle": "Book a service"
      },
      "stormOps": {
        "verticals": [
          "Snow Removal",
          "Lawn & Garden",
          "Pool & Spa",
          "Roofing",
          "Pest Control"
        ],
        "nav": [
          { "key": "orders.list", "label": "Home" },
          { "key": "calendar", "label": "Calendar" },
          { "key": "care", "labelSource": "verticalProfiles.careNavLabel" },
          { "key": "proposals.list", "label": "Contracts" },
          { "key": "services", "label": "Services" },
          { "key": "activity", "label": "Activity" },
          { "key": "support", "label": "Support" }
        ],
        "enabledModules": ["orders", "calendar", "activity", "proposals", "care", "services", "profile", "support"],
        "primary": { "label": "Request service", "action": "service.request" },
        "weatherCalendar": true,
        "calendarVariant": "storm",
        "showCart": false,
        "drawerTitle": "Request service"
      },
      "appointments": {
        "verticals": [
          "Health",
          "Beauty"
        ],
        "nav": [
          { "key": "orders.list", "label": "Appointments" },
          { "key": "calendar", "label": "Calendar" },
          { "key": "care", "labelSource": "verticalProfiles.careNavLabel" },
          { "key": "services", "label": "Services" },
          { "key": "pricing", "label": "Pricing" },
          { "key": "products", "label": "Products" },
          { "key": "support", "label": "Support" }
        ],
        "enabledModules": ["orders", "calendar", "care", "services", "pricing", "products", "checkout", "profile", "support"],
        "primary": { "label": "+ Book", "action": "booking.open" },
        "weatherCalendar": false,
        "calendarVariant": "month",
        "showCart": true,
        "drawerTitle": "Book an appointment"
      }
    },
    "note": "Calendar renders StormCalendar only when the business vertical supports weather and the effective profile is stormOps; visual config.theme never changes this decision. Health and Beauty have no weather fixture and never fall back to Snow content. Care labels come from the business vertical registry."
  },
  "routeRegistry": [
    { "id": "landing", "path": "/", "module": "landing", "auth": "public", "status": "done" },
    { "id": "seo.landing", "path": "/seo-preview", "module": "seo-parity", "auth": "public", "status": "s1-placeholder", "productionOwner": "separate public CMS document in S3/S6" },
    { "id": "auth.phone", "path": "/login", "module": "auth", "auth": "public", "status": "done" },
    { "id": "auth.code", "path": "/login/verify", "module": "auth", "auth": "public", "status": "done" },
    { "id": "orders.list", "path": "/orders", "module": "orders", "auth": "private", "status": "done" },
    { "id": "order.detail", "path": "/orders/:id", "module": "orders", "auth": "private", "status": "done" },
    { "id": "calendar", "path": "/calendar", "module": "calendar", "auth": "private", "status": "done" },
    { "id": "activity", "path": "/activity", "module": "activity", "auth": "private", "status": "done" },
    { "id": "services", "path": "/services", "module": "services", "auth": "private", "status": "done" },
    { "id": "pricing", "path": "/pricing", "module": "pricing", "auth": "private", "status": "done" },
    { "id": "products", "path": "/products", "module": "products", "auth": "private", "status": "done" },
    { "id": "checkout", "path": "/checkout", "module": "checkout", "auth": "private", "status": "done" },
    { "id": "proposals.list", "path": "/proposals", "module": "proposals", "auth": "private", "status": "done" },
    { "id": "proposal.detail", "path": "/proposals/:id", "module": "proposals", "auth": "private", "status": "done" },
    { "id": "profile", "path": "/profile", "module": "profile", "auth": "private", "status": "done" },
    { "id": "support", "path": "/support", "module": "support", "auth": "private", "status": "done" },
    { "id": "care", "path": "/care", "module": "care", "auth": "private", "status": "s1-placeholder", "guard": "module + session + control-plane entitlement" }
  ],
