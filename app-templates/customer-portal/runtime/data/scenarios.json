{
  "$schema": "./scenarios.schema (informal)",
  "product": "Aircove Customer Portal",
  "wave": 9,
  "description": "S3 SEO transfer with an explicit truth boundary: eight accepted reference fixture sets drive portal parity and a noindex checked reference preview, while the separate CMS public root requires complete authored content and deployment URL policy. S2 Care behavior remains preserved.",
  "featureFlags": {
    "showProducts": true,
    "showProposals": true,
    "showMemberships": true,
    "weatherTriggers": true,
    "darkMode": true
  },
  "themes": ["HVAC", "Snow Removal", "Lawn & Garden", "Pool & Spa", "Roofing", "Pest Control", "Health", "Beauty"],
  "modes": ["light", "dark"],
  "profiles": {
    "note": "Profile selection is config-driven. Care navigation is present only when the module is enabled; its label comes from the vertical registry.",
    "onDemand": { "verticals": ["HVAC"], "calendar": "MonthCalendar", "primary": "+ Book", "care": true, "cart": true },
    "stormOps": { "verticals": ["Snow Removal", "Lawn & Garden", "Pool & Spa", "Roofing", "Pest Control"], "calendar": "StormCalendar (weather-operational)", "primary": "Request service", "care": true, "cart": false },
    "appointments": { "verticals": ["Health", "Beauty"], "calendar": "MonthCalendar", "primary": "+ Book", "care": true, "cart": true, "weather": false }
  },
  "viewports": [390, 768, 1180, 1440],
  "routes": [
    { "id": "landing", "path": "/", "implemented": true, "auth": "public", "states": ["ready"] },
    { "id": "seo.landing", "path": "/seo-preview", "implemented": true, "auth": "public", "states": ["ready", "loading", "empty"], "verticals": ["HVAC", "Snow Removal", "Lawn & Garden", "Pool & Spa", "Roofing", "Pest Control", "Health", "Beauty"], "disposition": "Executable portal-shell reference parity route only; never a production public document" },
    { "id": "auth.phone", "path": "/login", "implemented": true, "auth": "public", "states": ["ready", "validation-error"] },
    { "id": "auth.code", "path": "/login/verify", "implemented": true, "auth": "public", "states": ["ready", "validation-error"] },
    { "id": "orders.list", "path": "/orders", "implemented": true, "auth": "private", "states": ["ready", "loading", "empty", "error", "mobile-navigation-open", "drawer-open", "pending-action", "success-toast"] },
    { "id": "order.detail", "path": "/orders/:id", "implemented": true, "auth": "private", "states": ["scheduled", "inProgress", "completed", "cancelled", "loading", "error"] },
    { "id": "calendar", "path": "/calendar", "implemented": true, "auth": "private", "states": ["ready", "empty"], "variants": { "onDemand": "month grid", "stormOps": "weather-operations agenda", "appointments": "month grid without weather" } },
    { "id": "activity", "path": "/activity", "implemented": true, "auth": "private", "states": ["ready", "empty"] },
    { "id": "services", "path": "/services", "implemented": true, "auth": "private", "states": ["ready", "loading"] },
    { "id": "pricing", "path": "/pricing", "implemented": true, "auth": "private", "states": ["ready"] },
    { "id": "products", "path": "/products", "implemented": true, "auth": "private", "states": ["ready", "empty", "loading"] },
    { "id": "checkout", "path": "/checkout", "implemented": true, "auth": "private", "states": ["ready", "empty", "pending-action", "success-toast"] },
    { "id": "proposals.list", "path": "/proposals", "implemented": true, "auth": "private", "states": ["ready", "empty"] },
    { "id": "proposal.detail", "path": "/proposals/:id", "implemented": true, "auth": "private", "states": ["unseen", "viewed", "approved", "revision", "declined"] },
    { "id": "profile", "path": "/profile", "implemented": true, "auth": "private", "states": ["ready", "success-toast"] },
    { "id": "support", "path": "/support", "implemented": true, "auth": "private", "states": ["ready", "pending-action"] },
    { "id": "care", "path": "/care", "implemented": true, "auth": "private", "states": ["ready", "loading", "empty", "error", "disabled", "unauthorized"], "disposition": "S2 fixture Care with protected adapter gated by module/session/scope/entitlement preflight; live adapter not opened" }
  ],
  "actions": [
    "auth.sendCode", "auth.verifyCode",
    "order.open", "order.cancel", "order.reschedule", "order.downloadInvoice", "order.filter",
    "booking.open", "booking.confirm",
    "weather.confirm", "weather.decline",
    "proposal.review", "proposal.approve", "proposal.requestRevision", "proposal.decline",
    "cart.addItem", "cart.removeItem", "cart.open", "checkout.placeOrder",
    "service.request", "service.requestExtra", "service.reportIssue", "access.confirm", "access.update",
    "membership.activate", "profile.updateAddress", "profile.setDefaultPayment",
    "support.open", "support.sendMessage",
    "nav.go", "theme.pick", "ui.toggleMode", "ui.toggleMobileNav", "ui.retry",
    "care.selectUnit", "care.download", "care.requestRetreat", "care.selectSpecialist", "care.completeTask", "care.contactProvider", "care.openSecureDoc",
    "seo.cta.book", "seo.cta.quote", "seo.cta.call", "seo.cta.services", "seo.service.select", "seo.faq.toggle"
  ],
  "implementedStates": {
    "orders.list": ["ready", "loading", "empty", "error", "mobile-navigation-open", "drawer-open", "pending-action", "success-toast"],
    "order.detail": ["scheduled", "inProgress", "completed", "cancelled", "loading", "error", "pending-action"],
    "services": ["ready", "loading"],
    "pricing": ["ready"],
    "products": ["ready", "empty"],
    "checkout": ["ready", "empty", "success-toast"],
    "proposals.list": ["ready", "empty"],
    "proposal.detail": ["unseen", "viewed", "approved", "revision", "declined"],
    "profile": ["ready", "success-toast"],
    "activity": ["ready", "empty"],
    "calendar": ["ready"],
    "support": ["ready", "pending-action"],
    "landing": ["ready"],
    "auth.phone": ["ready", "validation-error"],
    "auth.code": ["ready", "validation-error"],
    "care": ["ready", "loading", "empty", "error", "disabled", "unauthorized"],
    "seo.landing": ["ready", "loading", "empty", "cta-idle", "cta-pending", "cta-success", "cta-error", "service-selected", "faq-open"]
  },
  "careContract": {
    "verticalKinds": {
      "HVAC": "equipment",
      "Snow Removal": "seasonLog",
      "Lawn & Garden": "program",
      "Pool & Spa": "water",
      "Roofing": "roof",
      "Pest Control": "monitoring",
      "Health": "healthCare",
      "Beauty": "beautyCare"
    },
    "preflightNoCall": ["disabled", "unauthenticated", "not-entitled", "forbidden", "checking", "error"],
    "payloadStates": ["ready", "loading", "empty", "error"],
    "fixtureTransitions": ["care.selectUnit", "care.requestRetreat", "care.selectSpecialist", "care.completeTask"],
    "unavailableWithoutApprovedDestination": ["care.download", "care.contactProvider", "care.openSecureDoc"],
    "retreatConcurrency": "entity-keyed shared single-flight"
  },
  "seoContract": {
    "componentIds": ["seo-hero", "seo-trust-strip", "seo-service-card", "seo-services-grid", "seo-how-it-works", "seo-proof", "seo-pricing", "seo-service-area", "seo-reviews", "seo-faq", "seo-final-cta", "seo-footer", "seo-cta", "seo-meta-preview"],
    "sectionOrder": ["seo-hero", "seo-trust-strip", "seo-services-grid", "seo-how-it-works", "seo-proof", "seo-pricing", "seo-service-area", "seo-reviews", "seo-faq", "seo-final-cta", "seo-footer"],
    "actions": ["seo.cta.book", "seo.cta.quote", "seo.cta.call", "seo.cta.services", "seo.service.select", "seo.faq.toggle"],
    "dynamicStates": ["ready", "loading", "empty"],
    "ctaStates": ["idle", "pending", "success", "error", "unavailable"],
    "parityRoute": "runtime seo.landing; accepted reference fixtures and lifecycle/local-selection previews only",
    "referencePreview": "public/seo-reference-preview.html; checked deterministic noindex fixture artifact visibly classified reference-only",
    "strictCmsTemplate": "cms/seo-public-root-template.html; token-only and generated only from a complete public-authored payload plus deployment allowlists",
    "strictGenerator": "scripts/generate-seo-public.mjs; requires explicit --input and --output and has no mock defaults",
    "publicBoundary": "Strict public mode has no fixture fallback, portal auth/session object, AppShell, hash router, portal root boot, preview metadata, synthetic CTA lifecycle API, or invented facts."
  },
  "activationContract": {
    "inventory": "runtime/data/activation-contracts.json",
    "acceptedDataSources": ["care.fixture", "care.live", "seo.reference", "seo.publicAuthored"],
    "acceptedCareActions": ["care.selectUnit", "care.download", "care.requestRetreat", "care.selectSpecialist", "care.completeTask", "care.contactProvider", "care.openSecureDoc"],
    "acceptedSeoActions": ["seo.cta.book", "seo.cta.quote", "seo.cta.call", "seo.cta.services", "seo.service.select", "seo.faq.toggle"],
    "careSurfaceControls": {"inventoryRows": 21, "renderedInstances": 38, "allDataActionPrefixes": true},
    "openedLive": [],
    "notOpenedLive": ["care.live"],
    "healthSensitiveUnavailable": ["care.contactProvider", "care.openSecureDoc"]
  },
  "notImplementedYet": {
    "routes": [],
    "careLiveActions": ["care.selectUnit persistence", "care.download", "care.requestRetreat", "care.selectSpecialist persistence", "care.completeTask sync", "care.contactProvider", "care.openSecureDoc"],
    "seoCmsExport": ["S6 final block metadata, authored payload transport, and dual export wiring"],
    "note": "Care fixture behavior remains implemented. Care live IO/actions remain not_opened. S3 provides strict public normalization, the token-only CMS root contract, shared sections, and reference parity artifacts; S6 owns final CMS schema and packaging."
  }
}
